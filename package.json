{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.22.1"
  },
  "scripts": {
    "dev": "NODE_ENV=development tsx server.ts",
    "start": "node --env-file-if-exists=.env build/server.mjs",
    "build": "vite build && esbuild server.ts --bundle --platform=node --target=node24 --format=esm --packages=external --outfile=build/server.mjs",
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "password": "node scripts/password.mjs",
    "benchmark": "esbuild scripts/benchmark.ts --bundle --platform=node --target=node24 --format=esm --packages=external --outfile=build/benchmark.mjs && node build/benchmark.mjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "ccxt": "^4.5.0",
    "jszip": "^3.10.2",
    "lightweight-charts": "^5.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "overrides": { "undici": "7.30.1" },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "@types/express": "^4.17.21"
  }
}
