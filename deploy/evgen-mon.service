[Unit]
Description=Evgen private trading terminal
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=evgen-mon
Group=evgen-mon
WorkingDirectory=/opt/evgen-mon/current
EnvironmentFile=/etc/evgen-mon.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/env node --max-old-space-size=384 build/server.mjs
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/evgen-mon
MemoryHigh=512M
MemoryMax=768M
CPUQuota=50%
Nice=10
IOSchedulingClass=idle
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
