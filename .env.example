NODE_ENV=production
APP_ORIGIN=https://evgen.h00k.top
HOST=127.0.0.1
PORT=3010
ADMIN_USERNAME=admin
# Generate with npm run password. There is no default password.
ADMIN_PASSWORD_HASH=
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
# Generate a separate random secret; use it only as the cron Authorization bearer token.
CRON_SECRET=
DATA_DIR=./data
ENABLE_LIVE_TRADING=false
SCHEDULER_MODE=external
BINANCE_WEIGHT_BUDGET=1000
